{
  "name": "ai-novel-core",
  "version": "0.1.0",
  "private": true,
  "description": "Core AI Novel Factory engine: workflow, agents, memory, graph, and runtime LLM services",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server-core": {
      "types": "./dist/server-core.d.ts",
      "import": "./dist/server-core.js",
      "require": "./dist/server-core.cjs"
    },
    "./studio-server": {
      "types": "./dist/studio-server.d.ts",
      "import": "./dist/studio-server.js",
      "require": "./dist/studio-server.cjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "require": "./dist/worker.cjs"
    },
    "./embedding": {
      "types": "./dist/embedding.d.ts",
      "import": "./dist/embedding.js",
      "require": "./dist/embedding.cjs"
    },
    "./knowledge": {
      "types": "./dist/knowledge.d.ts",
      "import": "./dist/knowledge.js",
      "require": "./dist/knowledge.cjs"
    },
    "./aigc-detector": {
      "types": "./dist/aigc-detector.d.ts",
      "import": "./dist/aigc-detector.js",
      "require": "./dist/aigc-detector.cjs"
    },
    "./chapter-blueprint-learning": {
      "types": "./dist/chapter-blueprint-learning.d.ts",
      "import": "./dist/chapter-blueprint-learning.js",
      "require": "./dist/chapter-blueprint-learning.cjs"
    },
    "./workflow-kernel": {
      "types": "./dist/workflow-kernel.d.ts",
      "import": "./dist/workflow-kernel.js",
      "require": "./dist/workflow-kernel.cjs"
    },
    "./production-workflow": {
      "types": "./dist/production-workflow.d.ts",
      "import": "./dist/production-workflow.js",
      "require": "./dist/production-workflow.cjs"
    },
    "./production-workflow-sandbox": {
      "types": "./dist/production-workflow-sandbox.d.ts",
      "import": "./dist/production-workflow-sandbox.js",
      "require": "./dist/production-workflow-sandbox.cjs"
    },
    "./production-planning-workflow": {
      "types": "./dist/production-planning-workflow.d.ts",
      "import": "./dist/production-planning-workflow.js",
      "require": "./dist/production-planning-workflow.cjs"
    },
    "./production-chapter-workflow": {
      "types": "./dist/production-chapter-workflow.d.ts",
      "import": "./dist/production-chapter-workflow.js",
      "require": "./dist/production-chapter-workflow.cjs"
    },
    "./factory-langgraph-checkpointer": {
      "types": "./dist/factory-langgraph-checkpointer.d.ts",
      "import": "./dist/factory-langgraph-checkpointer.js",
      "require": "./dist/factory-langgraph-checkpointer.cjs"
    },
    "./workflow-debug-branch": {
      "types": "./dist/workflow-debug-branch.d.ts",
      "import": "./dist/workflow-debug-branch.js",
      "require": "./dist/workflow-debug-branch.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/server-core.ts src/studio-server.ts src/worker.ts src/embedding.ts src/knowledge.ts src/aigc-detector.ts src/writing-pipeline.ts src/novel-director.ts src/messages.ts src/chapter-blueprint-learning.ts src/workflow-kernel.ts src/production-workflow.ts src/production-planning-workflow.ts src/production-chapter-workflow.ts src/production-workflow-sandbox.ts src/factory-langgraph-checkpointer.ts src/workflow-debug-branch.ts src/world-foundation-debug-server.ts --format esm,cjs --dts --clean",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.8",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "esbuild": "^0.27.7"
  }
}
