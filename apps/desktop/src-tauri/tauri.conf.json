{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Novel Factory",
  "version": "0.1.0",
  "identifier": "com.ai-novel-factory.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4310"
  },
  "app": {
