{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:im-capability:operation-result:1.0",
  "title": "Capability Operation Result 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "invocationId", "operationId", "revision", "status", "artifacts"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "invocationId": { "type": "string", "minLength": 1 },
    "operationId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": ["accepted", "running", "cancel_requested", "succeeded", "failed", "cancelled", "reconciliation_required"]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "version", "mediaType", "title"],
        "properties": {
          "uri": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelCalls"],
      "properties": {
        "modelCalls": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "costUsd": { "type": "number", "minimum": 0 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["failed", "reconciliation_required"] } } },
      "then": { "properties": { "error": true }, "required": ["error"] }
    },
    {
      "if": { "properties": { "status": { "const": "succeeded" } } },
      "then": { "not": { "properties": { "error": true }, "required": ["error"] } }
    },
    {
      "if": { "properties": { "status": { "const": "reconciliation_required" } } },
      "then": { "properties": { "error": { "type": "object", "properties": { "retryable": { "const": false } } } } }
    }
  ]
}
